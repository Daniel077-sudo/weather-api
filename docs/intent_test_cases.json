{
  "_說明": "expect 只比對有列出的欄位（部分比對）；city 比對前會把「台」統一成「臺」；missing_fields_include 代表回應的 missing_fields 至少要包含這些值。全部以 client_now（星期三）為基準。",
  "client_now": "2026-09-23T19:30:00+08:00",
  "current_location": "高雄市左營區",
  "cases": [
    { "id": "create-01", "input": "明天下午三點去台南開會",
      "expect": { "intent": "CREATE_EVENT", "is_question": false, "needs_clarification": false,
                  "draft_event": { "title": "開會", "date": "2026-09-24", "start_time": "15:00", "city": "臺南市" } } },
    { "id": "create-02", "input": "可以幫我排明天下午三點在台南開會嗎？",
      "expect": { "intent": "CREATE_EVENT", "is_question": true, "needs_clarification": false,
                  "draft_event": { "title": "開會", "date": "2026-09-24", "start_time": "15:00", "city": "臺南市" } } },
    { "id": "create-03", "input": "9月25日下午2點在台南東區游泳",
      "expect": { "intent": "CREATE_EVENT", "needs_clarification": false,
                  "draft_event": { "title": "游泳", "date": "2026-09-25", "start_time": "14:00", "city": "臺南市", "district": "東區" } } },
    { "id": "create-04", "input": "我要去游泳",
      "expect": { "intent": "CREATE_EVENT", "needs_clarification": true,
                  "missing_fields_include": ["date", "start_time", "city"], "draft_event": { "title": "游泳" } } },
    { "id": "create-05", "input": "明天想去游泳",
      "expect": { "intent": "CREATE_EVENT", "needs_clarification": true,
                  "missing_fields_include": ["start_time", "city"], "draft_event": { "title": "游泳", "date": "2026-09-24" } } },
    { "id": "create-06-no-city", "input": "明天早上九點開會",
      "_備註": "沒講地點：不可自動填 current_location（高雄市），要列入 missing_fields",
      "expect": { "intent": "CREATE_EVENT", "needs_clarification": true, "missing_fields_include": ["city"],
                  "draft_event": { "title": "開會", "date": "2026-09-24", "start_time": "09:00", "city": null } } },
    { "id": "create-07-no-fake-district", "input": "明天下午三點要去台南爬山",
      "_備註": "有縣市沒鄉鎮：district 必須是 null，不可捏造",
      "expect": { "intent": "CREATE_EVENT",
                  "draft_event": { "title": "爬山", "date": "2026-09-24", "start_time": "15:00", "city": "臺南市", "district": null } } },
    { "id": "create-08-missing-title-time", "input": "後天去高雄",
      "expect": { "intent": "CREATE_EVENT", "needs_clarification": true,
                  "missing_fields_include": ["title", "start_time"],
                  "draft_event": { "title": null, "date": "2026-09-25", "start_time": null, "city": "高雄市" } } },

    { "id": "query-event-01", "input": "後天有行程嗎？",
      "expect": { "intent": "QUERY_EVENT", "is_question": true, "entities": { "start_date": "2026-09-25", "end_date": "2026-09-25" } } },
    { "id": "query-event-02", "input": "明天有什麼安排？",
      "expect": { "intent": "QUERY_EVENT", "entities": { "start_date": "2026-09-24" } } },
    { "id": "query-event-03", "input": "我今天有空嗎？",
      "expect": { "intent": "QUERY_EVENT", "entities": { "start_date": "2026-09-23" } } },
    { "id": "query-event-04", "input": "星期五有什麼行程？",
      "_備註": "星期五 = 從今天起最近的星期五（本週 9/25），不是下週",
      "expect": { "intent": "QUERY_EVENT", "entities": { "start_date": "2026-09-25" } } },
    { "id": "query-event-05", "input": "下星期五有事嗎？",
      "expect": { "intent": "QUERY_EVENT", "entities": { "start_date": "2026-10-02" } } },
    { "id": "query-event-06", "input": "這週末有什麼行程？",
      "expect": { "intent": "QUERY_EVENT", "entities": { "start_date": "2026-09-26", "end_date": "2026-09-27" } } },
    { "id": "query-event-07", "input": "我明天是不是要去游泳？",
      "expect": { "intent": "QUERY_EVENT", "is_question": true, "entities": { "start_date": "2026-09-24", "activity": "游泳" } } },
    { "id": "query-event-08", "input": "我明天要去台北嗎？",
      "expect": { "intent": "QUERY_EVENT", "entities": { "start_date": "2026-09-24" } } },

    { "id": "delete-01", "input": "把明天的開會取消",
      "expect": { "intent": "DELETE_EVENT", "event_filter": { "date": "2026-09-24", "title_keyword": "開會" } } },
    { "id": "delete-02", "input": "刪掉後天下午三點的行程",
      "expect": { "intent": "DELETE_EVENT", "event_filter": { "date": "2026-09-25", "time": "15:00" } } },

    { "id": "update-01", "input": "把明天開會改成下午4點",
      "expect": { "intent": "UPDATE_EVENT", "event_filter": { "date": "2026-09-24", "title_keyword": "開會" },
                  "changes": { "start_time": "16:00" } } },
    { "id": "update-02", "input": "把星期五的游泳改到星期六",
      "expect": { "intent": "UPDATE_EVENT", "event_filter": { "date": "2026-09-25", "title_keyword": "游泳" },
                  "changes": { "date": "2026-09-26" } } },

    { "id": "weather-01", "input": "明天台南會下雨嗎？",
      "expect": { "intent": "QUERY_WEATHER", "is_question": true, "entities": { "start_date": "2026-09-24", "city": "臺南市" } } },
    { "id": "weather-02", "input": "今天要帶傘嗎？",
      "expect": { "intent": "QUERY_WEATHER", "entities": { "start_date": "2026-09-23", "city": null } } },

    { "id": "event-weather-01", "input": "明天去台南開會會下雨嗎？",
      "_備註": "同時有「去／台南／開會」，但最終需求是問天氣，不可判成 CREATE_EVENT",
      "expect": { "intent": "EVENT_WEATHER", "entities": { "start_date": "2026-09-24", "city": "臺南市", "activity": "開會" } } },
    { "id": "event-weather-02", "input": "你覺得明天適合跑步嗎？",
      "expect": { "intent": "EVENT_WEATHER", "entities": { "start_date": "2026-09-24", "activity": "跑步" } } },
    { "id": "event-weather-03", "input": "明天是不是適合去跑步？",
      "expect": { "intent": "EVENT_WEATHER", "entities": { "activity": "跑步" } } },
    { "id": "event-weather-04-bike", "input": "明天適合騎腳踏車嗎？",
      "expect": { "intent": "EVENT_WEATHER", "entities": { "start_date": "2026-09-24", "activity": "騎腳踏車" } } },

    { "id": "disaster-01", "input": "台灣颱風警報怎麼分？", "expect": { "intent": "DISASTER_INFO" } },
    { "id": "disaster-02", "input": "地震的時候要躲在哪裡？", "expect": { "intent": "DISASTER_INFO" } },

    { "id": "chat-01", "input": "哈囉 BMO", "expect": { "intent": "GENERAL_CHAT" } },
    { "id": "chat-02", "input": "游泳是什麼運動？", "expect": { "intent": "GENERAL_CHAT" } },

    { "id": "multi-01-fill", "input": "下午三點開會", "intent_hint": "CREATE_EVENT",
      "draft_event": { "title": null, "date": "2026-09-24", "start_time": null, "end_time": null, "city": "臺南市", "district": null, "location": "台南" },
      "_備註": "草稿原有的 date、city 必須保留，補上 title 與 start_time",
      "expect": { "intent": "CREATE_EVENT", "needs_clarification": false,
                  "draft_event": { "title": "開會", "date": "2026-09-24", "start_time": "15:00", "city": "臺南市" } } },
    { "id": "multi-02-switch-topic", "input": "明天高雄會下雨嗎？", "intent_hint": "CREATE_EVENT",
      "draft_event": { "title": null, "date": "2026-09-24", "start_time": null, "end_time": null, "city": "臺南市", "district": null, "location": "台南" },
      "_備註": "正在補草稿時換話題：intent_hint 只是提示，要依原話判成天氣查詢",
      "expect": { "intent": "QUERY_WEATHER", "entities": { "start_date": "2026-09-24", "city": "高雄市" } } },
    { "id": "multi-03-cancel", "input": "不用了", "intent_hint": "CREATE_EVENT",
      "draft_event": { "title": "開會", "date": "2026-09-24", "start_time": null, "end_time": null, "city": "臺南市", "district": null, "location": "台南" },
      "_備註": "使用者放棄：不可再回 CREATE_EVENT，App 收到不同 intent 會自己作廢草稿",
      "expect": { "intent": "GENERAL_CHAT" } }
  ]
}
